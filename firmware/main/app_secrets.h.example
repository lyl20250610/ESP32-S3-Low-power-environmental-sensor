/**
 * @file app_secrets.h.example
 * @brief 凭据模板。复制成 app_secrets.h 后填入真实值。
 *
 *   PowerShell:  Copy-Item app_secrets.h.example app_secrets.h
 *
 * ⚠️⚠️ 重要安全约定 ⚠️⚠️
 *   1. 本 Git 仓库是 **PUBLIC**（公开）仓库。
 *   2. app_secrets.h 已被仓库根目录的 .gitignore 排除，**永远不要**把它提交上去，
 *      也**永远不要**用 `git add -f` 强加。
 *   3. 提交前务必先跑一次 `git status`，确认输出里没有 app_secrets.h。
 *   4. 本工程里除 app_secrets.h 外，任何文件都不允许出现 Wi-Fi 密码或 OneNET 密钥。
 *
 * 宏名刻意与参考工程 AloT 的 components/MY_MQTT/app_secrets.h 保持一致，
 * 这样移植 onenet 组件时不需要改名字。
 */

#pragma once

/* ---------------------------------------------------------------------------
 * 一、Wi-Fi（必须是 2.4GHz 频段；ESP32-S3 不支持 5GHz）
 * --------------------------------------------------------------------------- */
#define WIFI_SSID               "在这里填WiFi名称"
#define WIFI_PASSWORD           "在这里填WiFi密码"

/* ---------------------------------------------------------------------------
 * 二、OneNET Studio —— MQTT 设备三元组
 *
 * 在 https://open.iot.10086.cn 控制台：
 *   1) 先完成账号实名认证
 *   2) 产品开发 → 创建产品（协议选 MQTT，数据格式选「物模型」/OneJSON）
 *   3) 设备管理 → 添加设备，设备名称填 node01
 *   4) 把下面三个值抄过来：
 *        ONENET_PRODUCT_ID   = 产品的「产品 ID」，10 位字母+数字短串
 *                             （形如 pqMrwnhhin；在「产品开发 → 产品信息」页；
 *                              它就是 MQTT 连接用的 username，也出现在上报主题里）
 *        ONENET_DEVICE_NAME  = 设备名称（本项目固定 node01，必须与控制台一字不差）
 *        ONENET_DEVICE_KEY   = 设备的「设备密钥 / 鉴权信息」，约 44 位 Base64 串
 *                             （在「设备管理 → 设备详情」，可能要按「显示」才可见）
 *
 * 注意：必须为本项目**新建独立产品**，不要复用 AloT 的产品/设备。
 *       两台设备用同一套 client_id 登录会互相顶下线，表现为"连上→秒断→重连"。
 * --------------------------------------------------------------------------- */
#define ONENET_PRODUCT_ID       "在这里填产品ID"
#define ONENET_DEVICE_NAME      "node01"
#define ONENET_DEVICE_KEY       "在这里填设备密钥"

/* ---------------------------------------------------------------------------
 * 三、可选：产品级 API Key
 * 本项目节点只做"上报"，不订阅平台下发的属性设置，因此可留空。
 * --------------------------------------------------------------------------- */
#define ONENET_PRODUCT_KEY      ""

/* ---------------------------------------------------------------------------
 * 四、可选：OneNET 应用 API 凭据（给 PC 端 tools/onenet_pull.py 拉历史数据用）
 * 不属于固件凭据，但放在同一个文件里可以统一被 .gitignore 保护。
 * --------------------------------------------------------------------------- */
#define ONENET_API_ACCESS_KEY   ""
#define ONENET_API_USER_ID      ""
